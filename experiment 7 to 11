/* EXPERIMENT 7 - TASK 1: LARGEST ELEMENT IN AN ARRAY */
void largestElement() {
    int n, i, largest;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("Invalid size.\n");
        return;
    }

    int arr[n];

    printf("Enter array elements:\n");
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    largest = arr[0];

    for (i = 1; i < n; i++) {
        if (arr[i] > largest) {
            largest = arr[i];
        }
    }

    printf("Largest element = %d\n", largest);
}

/* EXPERIMENT 7 - TASK 2: SUM OF TWO MATRICES */
void sumMatrices() {
    int r, c, i, j;

    printf("Enter rows and columns: ");
    scanf("%d %d", &r, &c);

    if (r <= 0 || c <= 0) {
        printf("Invalid matrix size.\n");
        return;
    }

    int a[r][c], b[r][c], sum[r][c];

    printf("Enter first matrix:\n");
    for (i = 0; i < r; i++) {
        for (j = 0; j < c; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    printf("Enter second matrix:\n");
    for (i = 0; i < r; i++) {
        for (j = 0; j < c; j++) {
            scanf("%d", &b[i][j]);
        }
    }

    printf("Sum of matrices:\n");
    for (i = 0; i < r; i++) {
        for (j = 0; j < c; j++) {
            sum[i][j] = a[i][j] + b[i][j];
            printf("%d\t", sum[i][j]);
        }
        printf("\n");
    }
}

/* EXPERIMENT 8 - TASK 1: STRING LENGTH WITHOUT LIBRARY FUNCTIONS */
void stringLength() {
    char str[100];
    int length = 0;

    printf("Enter a string: ");
    scanf("%99s", str);

    while (str[length] != '\0') {
        length++;
    }

    printf("Length of string = %d\n", length);
}

/* EXPERIMENT 8 - TASK 2: PALINDROME STRING */
void palindrome() {
    char str[100];
    int i, length, flag = 0;

    printf("Enter a string: ");
    scanf("%99s", str);

    length = strlen(str);

    for (i = 0; i < length / 2; i++) {
        if (str[i] != str[length - 1 - i]) {
            flag = 1;
            break;
        }
    }

    if (flag == 0) {
        printf("%s is a palindrome.\n", str);
    } else {
        printf("%s is not a palindrome.\n", str);
    }
}

/* EXPERIMENT 9 - TASK 1: TOPPER DETAILS OF 5 STUDENTS */
struct student_record {
    char name[50];
    int roll_number;
    float total_marks;
};

void studentTopper() {
    struct student_record students[5];
    int i, topper_index = 0;

    printf("Enter details of 5 students:\n");

    for (i = 0; i < 5; i++) {
        printf("Enter name, roll number and marks: ");
        scanf("%49s %d %f",
              students[i].name,
              &students[i].roll_number,
              &students[i].total_marks);
    }

    for (i = 1; i < 5; i++) {
        if (students[i].total_marks >
            students[topper_index].total_marks) {
            topper_index = i;
        }
    }

    printf("\n--- TOPPER DETAILS ---\n");
    printf("Name: %s\n", students[topper_index].name);
    printf("Roll Number: %d\n",
           students[topper_index].roll_number);
    printf("Marks: %.2f\n",
           students[topper_index].total_marks);
}

/* EXPERIMENT 10 - TASK 1: ADD TWO NUMBERS USING POINTERS */
void addUsingPointers() {
    int num1, num2, sum;
    int *ptr1 = &num1;
    int *ptr2 = &num2;

    printf("Enter two numbers: ");
    scanf("%d %d", ptr1, ptr2);

    sum = *ptr1 + *ptr2;

    printf("Sum = %d\n", sum);
}

/* EXPERIMENT 10 - TASK 2: REVERSE ARRAY USING POINTERS */
void reverseArray() {
    int n, i;

    printf("Enter array size: ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("Invalid size.\n");
        return;
    }

    int arr[n];

    printf("Enter array elements:\n");
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    int *ptr = &arr[n - 1];

    printf("Reversed array: ");
    for (i = n - 1; i >= 0; i--) {
        printf("%d ", *ptr);
        ptr--;
    }

    printf("\n");
}

/* EXPERIMENT 11 - TASK 1: EMPLOYEE DATABASE USING FILES */
void employeeDatabase() {
    FILE *file;
    int emp_id, n, i;
    char name[50];
    float salary;

    file = fopen("employee.txt", "w");

    if (file == NULL) {
        printf("Unable to open file.\n");
        return;
    }

    printf("Enter number of employees: ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("Invalid number of employees.\n");
        fclose(file);
        return;
    }

    for (i = 0; i < n; i++) {
        printf("Enter ID, Name and Salary: ");
        scanf("%d %49s %f", &emp_id, name, &salary);

        fprintf(file, "%d %s %.2f\n",
                emp_id, name, salary);
    }

    fclose(file);

    file = fopen("employee.txt", "r");

    if (file == NULL) {
        printf("Unable to read file.\n");
        return;
    }

    printf("\n--- STORED EMPLOYEE DATABASE RECORDS ---\n");

    while (fscanf(file, "%d %49s %f",
                  &emp_id, name, &salary) == 3) {
        printf("ID: %d | Name: %-10s | Salary: %.2f\n",
               emp_id, name, salary);
    }

    fclose(file);
}

